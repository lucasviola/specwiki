{
  "name": "specwiki",
  "version": "0.1.0",
  "description": "Transform AI specs into structured wiki-like documentation",
  "type": "module",
  "bin": {
    "specwiki": "./dist/cli.js"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc && node scripts/copy-html-assets.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "keywords": [
    "cli",
    "documentation",
    "wiki",
    "ai-specs",
    "spec-driven"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.7",
    "mustache": "^4.2.0",
    "wikimedia-ui-base": "^0.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
