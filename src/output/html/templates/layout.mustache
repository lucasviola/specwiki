<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{pageTitle}} — Spec Wiki</title>
  <link rel="stylesheet" href="assets/specwiki.css">
  {{#includeHighlightCss}}
  <link rel="stylesheet" href="assets/highlight.css">
  {{/includeHighlightCss}}
</head>
<body class="specwiki">
  <header class="specwiki-header">
    <div class="specwiki-header-inner">
      <a href="index.html" class="specwiki-logo">Spec Wiki</a>
      {{#includeSearch}}
      <div class="specwiki-search">
        <label for="specwiki-search-input" class="specwiki-search-label">Search</label>
        <input
          type="search"
          id="specwiki-search-input"
          class="specwiki-search-input"
          placeholder="Search specs…"
          autocomplete="off"
        >
        <div id="specwiki-search-results" class="specwiki-search-results" hidden></div>
      </div>
      {{/includeSearch}}
    </div>
  </header>
  <div class="specwiki-main">
    {{{body}}}
  </div>
  {{#includeSearch}}
  <script type="application/json" id="search-index">{{{searchIndexJson}}}</script>
  <script src="assets/lunr.min.js"></script>
  <script src="assets/search.js"></script>
  {{/includeSearch}}
</body>
</html>
