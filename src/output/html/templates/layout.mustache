<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="generator" content="specwiki">
  <script data-specwiki-theme-init>
    (function () {
      "use strict";
      try {
        var theme = localStorage.getItem("specwiki-theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.dataset.theme = theme;
        }
      } catch {}
    })();
  </script>
  <title>{{pageTitle}} — Spec Wiki</title>
  <link rel="stylesheet" href="assets/specwiki.css">
  {{#includeHighlightCss}}
  <link rel="stylesheet" href="assets/highlight.css">
  {{/includeHighlightCss}}
</head>
<body class="specwiki">
  <header class="specwiki-header">
    <div class="specwiki-header-inner">
      <button
        id="specwiki-nav-toggle"
        type="button"
        hidden
        class="specwiki-nav-toggle"
        aria-label="Open category navigation"
        aria-controls="specwiki-nav-drawer"
        aria-expanded="false"
      >
        <span aria-hidden="true">☰</span>
        <span class="specwiki-nav-toggle-label">Menu</span>
      </button>
      <a href="index.html" class="specwiki-logo"><span class="specwiki-logo-bracket">[[</span>specwiki<span class="specwiki-logo-bracket">]]</span></a>
      {{#includeSearch}}
      <div class="specwiki-search">
        <label for="specwiki-search-input" class="specwiki-search-label">Search</label>
        <input
          type="search"
          id="specwiki-search-input"
          class="specwiki-search-input"
          placeholder="Search specs…"
          autocomplete="off"
          role="combobox"
          aria-autocomplete="list"
          aria-controls="specwiki-search-results"
          aria-expanded="false"
        >
        <div
          id="specwiki-search-results"
          class="specwiki-search-results"
          role="listbox"
          hidden
        >
          <div id="specwiki-search-groups"></div>
          <p
            id="specwiki-search-status"
            class="specwiki-search-empty"
            role="status"
            aria-live="polite"
            hidden
          ></p>
        </div>
      </div>
      {{/includeSearch}}
      <button
        type="button"
        id="specwiki-theme-toggle"
        hidden
        class="specwiki-theme-toggle"
        aria-label="Switch color theme"
        aria-pressed="false"
      >
        <span aria-hidden="true">◐</span>
        <span>Theme</span>
      </button>
    </div>
  </header>
  <div class="specwiki-main">
    {{{body}}}
  </div>
  <div
    id="specwiki-nav-backdrop"
    class="specwiki-nav-backdrop"
    hidden
    aria-hidden="true"
  ></div>
  {{#includeSearch}}
  <script type="application/json" id="search-index">{{{searchIndexJson}}}</script>
  <script src="assets/lunr.min.js"></script>
  <script src="assets/search.js"></script>
  {{/includeSearch}}
  <script data-specwiki-nav-drawer>
    (function () {
      "use strict";
      var root = document.documentElement;
      var toggle = document.getElementById("specwiki-nav-toggle");
      var drawer = document.getElementById("specwiki-nav-drawer");
      var close = document.getElementById("specwiki-nav-close");
      var backdrop = document.getElementById("specwiki-nav-backdrop");
      if (!toggle || !drawer || !close || !backdrop) {
        return;
      }

      var narrow = window.matchMedia("(max-width: 719px)");

      function setOpen(open, restoreFocus) {
        root.classList.toggle("specwiki-nav-open", open);
        toggle.setAttribute("aria-expanded", String(open));
        drawer.setAttribute("aria-hidden", String(!open));
        drawer.inert = !open;
        backdrop.hidden = !open;
        if (restoreFocus) {
          toggle.focus();
        }
      }

      function syncViewport() {
        if (narrow.matches) {
          setOpen(false, false);
        } else {
          root.classList.remove("specwiki-nav-open");
          toggle.setAttribute("aria-expanded", "false");
          drawer.removeAttribute("aria-hidden");
          drawer.inert = false;
          backdrop.hidden = true;
        }
      }

      root.classList.add("specwiki-nav-enhanced");
      toggle.hidden = false;
      close.hidden = false;
      toggle.addEventListener("click", function () {
        setOpen(toggle.getAttribute("aria-expanded") !== "true", false);
      });
      close.addEventListener("click", function () {
        setOpen(false, true);
      });
      backdrop.addEventListener("click", function () {
        setOpen(false, true);
      });
      document.addEventListener("keydown", function (event) {
        if (
          event.key === "Escape" &&
          toggle.getAttribute("aria-expanded") === "true"
        ) {
          setOpen(false, true);
        }
      });
      if (narrow.addEventListener) {
        narrow.addEventListener("change", syncViewport);
      }
      syncViewport();
    })();
  </script>
  <script data-specwiki-theme-toggle>
    (function () {
      "use strict";
      var root = document.documentElement;
      var toggle = document.getElementById("specwiki-theme-toggle");
      if (!toggle) {
        return;
      }

      function isDark() {
        if (root.dataset.theme) {
          return root.dataset.theme === "dark";
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches;
      }

      function syncToggle() {
        var dark = isDark();
        toggle.setAttribute("aria-pressed", String(dark));
        toggle.title = dark ? "Switch to light theme" : "Switch to dark theme";
        toggle.hidden = false;
      }

      toggle.addEventListener("click", function () {
        var theme = isDark() ? "light" : "dark";
        root.dataset.theme = theme;
        try {
          localStorage.setItem("specwiki-theme", theme);
        } catch {}
        syncToggle();
      });

      var preference = window.matchMedia("(prefers-color-scheme: dark)");
      if (preference.addEventListener) {
        preference.addEventListener("change", function () {
          if (!root.dataset.theme) {
            syncToggle();
          }
        });
      }
      syncToggle();
    })();
  </script>
</body>
</html>
