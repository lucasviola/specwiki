<div class="specwiki-layout">
  <aside id="specwiki-nav-drawer" class="specwiki-nav-drawer">
    <button
      type="button"
      id="specwiki-nav-close"
      hidden
      class="specwiki-nav-close"
      aria-label="Close category navigation"
    >
      <span aria-hidden="true">×</span>
    </button>
    <nav class="category-nav" aria-label="Categories">
      {{#categories}}
      {{#collapsible}}
      <details class="category-nav-group" data-category="{{key}}" {{#open}}open{{/open}}>
        <summary class="category-nav-summary">
          <a href="index.html#{{anchor}}" class="category-nav-heading">{{label}}</a>
          <span class="category-nav-count" aria-label="{{pageCount}} pages">{{pageCount}}</span>
        </summary>
        <ul class="category-nav-pages">
          {{#pages}}
          <li><a href="{{href}}">{{title}}</a></li>
          {{/pages}}
          {{#subgroups}}
          {{> nav-subgroup}}
          {{/subgroups}}
        </ul>
      </details>
      {{/collapsible}}
      {{^collapsible}}
      <div class="category-nav-group" data-category="{{key}}">
        <a href="index.html#{{anchor}}" class="category-nav-heading">{{label}}</a>
        <ul class="category-nav-pages">
          {{#pages}}
          <li><a href="{{href}}">{{title}}</a></li>
          {{/pages}}
          {{#subgroups}}
          {{> nav-subgroup}}
          {{/subgroups}}
        </ul>
      </div>
      {{/collapsible}}
      {{/categories}}
    </nav>
  </aside>
  <div class="specwiki-center">
    <article class="specwiki-portal" id="content">
      <h1>Main Page</h1>
      {{#hasRootIntro}}
      <div class="specwiki-portal-intro mw-parser-output">
        {{{rootIntroHtml}}}
      </div>
      {{/hasRootIntro}}
      {{^hasRootIntro}}
      <p class="specwiki-portal-intro">
        Structured documentation generated from AI specs, agent instructions,
        and spec-driven development files in this project.
      </p>
      {{/hasRootIntro}}
      <p><strong>{{pageCount}}</strong> {{pageCountLabel}} indexed.</p>
      {{#categories}}
      <section id="{{anchor}}" class="specwiki-category-section">
        <h2>{{label}}</h2>
        {{#hasIntro}}
        <div class="specwiki-category-intro mw-parser-output">
          {{{introHtml}}}
        </div>
        {{/hasIntro}}
        <ul class="specwiki-portal-pages">
          {{#portalPages}}
          <li><a href="{{href}}">{{title}}</a> — <code>{{sourcePath}}</code></li>
          {{/portalPages}}
        </ul>
      </section>
      {{/categories}}
      <section id="all-pages" class="specwiki-all-pages">
        <h2>All pages</h2>
        <ul class="specwiki-portal-pages">
          {{#allPages}}
          <li><a href="{{href}}">{{title}}</a></li>
          {{/allPages}}
        </ul>
      </section>
    </article>
  </div>
</div>
