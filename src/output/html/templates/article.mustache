<div class="specwiki-layout specwiki-layout-article">
  <aside id="specwiki-nav-drawer" class="specwiki-nav-drawer">
    <button
      type="button"
      id="specwiki-nav-close"
      hidden
      class="specwiki-nav-close"
      aria-label="Close category navigation"
    >
      <span aria-hidden="true">×</span>
    </button>
    <nav class="category-nav" aria-label="Categories">
      {{#categories}}
      {{#collapsible}}
      <details class="category-nav-group{{#active}} category-nav-active{{/active}}" data-category="{{key}}" {{#open}}open{{/open}}>
        <summary class="category-nav-summary">
          <a href="index.html#{{anchor}}" class="category-nav-heading">{{label}}</a>
          <span class="category-nav-count" aria-label="{{pageCount}} pages">{{pageCount}}</span>
        </summary>
        <ul class="category-nav-pages">
          {{#pages}}
          <li><a href="{{href}}">{{title}}</a></li>
          {{/pages}}
          {{#subgroups}}
          {{> nav-subgroup}}
          {{/subgroups}}
        </ul>
      </details>
      {{/collapsible}}
      {{^collapsible}}
      <div class="category-nav-group{{#active}} category-nav-active{{/active}}" data-category="{{key}}">
        <a href="index.html#{{anchor}}" class="category-nav-heading">{{label}}</a>
        <ul class="category-nav-pages">
          {{#pages}}
          <li><a href="{{href}}">{{title}}</a></li>
          {{/pages}}
          {{#subgroups}}
          {{> nav-subgroup}}
          {{/subgroups}}
        </ul>
      </div>
      {{/collapsible}}
      {{/categories}}
    </nav>
  </aside>
  <div class="specwiki-center">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      {{#breadcrumbs}}
      {{^first}} › {{/first}}
      {{#href}}<a href="{{href}}">{{label}}</a>{{/href}}
      {{^href}}{{#current}}<span aria-current="page">{{label}}</span>{{/current}}{{^current}}<span>{{label}}</span>{{/current}}{{/href}}
      {{/breadcrumbs}}
    </nav>
    <aside class="infobox">
      <h2 class="infobox-title">{{title}}</h2>
      <table class="infobox-table">
        <tbody>
          <tr>
            <th scope="row">Category</th>
            <td>{{categoryLabel}}</td>
          </tr>
          <tr>
            <th scope="row">Source</th>
            <td><code>{{sourcePath}}</code></td>
          </tr>
          {{#hasDescription}}
          <tr>
            <th scope="row">Summary</th>
            <td>{{description}}</td>
          </tr>
          {{/hasDescription}}
        </tbody>
      </table>
    </aside>
    <main id="content" class="specwiki-article-body">
      <div class="mw-parser-output">
        {{{content}}}
      </div>
    </main>
  </div>
  {{#hasToc}}
  <nav class="toc" aria-label="Table of contents">
    <h2 class="toc-heading">Contents</h2>
    <ul class="toc-list">
      {{#tocEntries}}
      <li class="toc-level-{{level}}"><a href="{{href}}">{{title}}</a></li>
      {{/tocEntries}}
    </ul>
  </nav>
  {{/hasToc}}
</div>
