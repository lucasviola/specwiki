<li class="category-nav-subgroup">
  {{#collapsible}}
  <details class="category-nav-subgroup-group" data-subgroup="{{{key}}}" {{#open}}open{{/open}}>
    <summary class="category-nav-subgroup-summary">
      <span class="category-nav-subgroup-label">{{label}}</span>
      <span class="category-nav-count" aria-label="{{pageCount}} pages">{{pageCount}}</span>
    </summary>
    <ul class="category-nav-subgroup-pages">
      {{#pages}}
      <li><a href="{{href}}">{{title}}</a></li>
      {{/pages}}
      {{#subgroups}}
      {{> nav-subgroup-nested}}
      {{/subgroups}}
    </ul>
  </details>
  {{/collapsible}}
  {{^collapsible}}
  <span class="category-nav-subgroup-label">{{label}}</span>
  <ul class="category-nav-subgroup-pages">
    {{#pages}}
    <li><a href="{{href}}">{{title}}</a></li>
    {{/pages}}
    {{#subgroups}}
    {{> nav-subgroup-nested}}
    {{/subgroups}}
  </ul>
  {{/collapsible}}
</li>
